# 이 파일을 복사해 .env 로 만들고 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다. 실제 키는 여기가 아니라 .env 에 적습니다.
#
# 셸 환경변수로 설정해도 됩니다. 셸에 설정된 값이 .env 보다 우선합니다.
#   export KOSIS_API_KEY="..."          # Windows PowerShell: $env:KOSIS_API_KEY="..."
#
# 발급: https://kosis.kr/openapi 회원가입 후 "Open API 사용 신청"
# 인증키가 없으면 python run.py --offline 으로 전 과정을 그대로 돌릴 수 있습니다.
KOSIS_API_KEY=
